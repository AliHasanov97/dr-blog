# C# API-nin baza ünvanı
NEXT_PUBLIC_API_BASE_URL=https://localhost:7001/api

# true  -> lib/mock/* faylarından data oxunur (hazırkı rejim)
# false -> real API-yə sorğu göndərilir
NEXT_PUBLIC_USE_MOCK=true

# Admin sessiya cookie-sini imzalayan açar (HMAC-SHA256). Bunsuz istehsalat
# rejimində (NODE_ENV=production) tətbiq açılmır — imzasız cookie qəbul
# edilmir, əks halda istənilən kəs özünü admin kimi göstərə bilərdi.
# Yaratmaq üçün:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# ---------------------------------------------------------------
# Gmail ile mektub gonderme
# ---------------------------------------------------------------
# GMAIL_APP_PASSWORD adi hesab parolu DEYIL — Google «Tetbiq parolu»dur:
#   1) Google hesabinda 2 addimli dogrulamani (2FA) aktiv edin
#   2) myaccount.google.com/apppasswords -> yeni parol yaradin
#   3) Verilen 16 herfli kodu (bosluqlarsiz da olar) buraya yazin
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Mektubda gorunen gonderen adi (bos buraxilsa hekim profilindeki ad islenir)
MAIL_FROM_NAME=

# Mektublardaki linklerin baza unvani (son «/» olmadan)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------
# Cloudflare R2 — sekil ve sened anbari
# ---------------------------------------------------------------
# Bos buraxilsa fayllar `public/uploads` qovluguna yazilir (yalniz lokal is
# ucun — deploy zamani itir). Hamisi doldurulanda avtomatik R2-ye kecir.
#
# Hardan tapilir:
#   R2_ACCOUNT_ID        Cloudflare panel -> R2 -> sag ustde «Account ID»
#   R2_ACCESS_KEY_ID     R2 -> Manage API Tokens -> Create -> «Access Key ID»
#   R2_SECRET_ACCESS_KEY eyni yerde, «Secret Access Key» (yalniz bir defe gorunur)
#   R2_BUCKET            yaratdiginiz bucket-in adi
#   R2_PUBLIC_URL        bucket -> Settings -> Public access
#                        (ozel domen tovsiye olunur, mes. https://media.saytiniz.az)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
