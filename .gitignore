# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env fayllari — GIZLI ACARLAR (DATABASE_URL, R2, GMAIL) BURADADIR
# Hec bir halda commit edilmemelidir. Numune fayl istisnadir.
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Yuklenen fayllar artiq Cloudflare R2-dedir; bu qovluq yalniz
# kohne qeydlerin qalidi kimi saxlanilir.
/public/uploads/*
!/public/uploads/.gitkeep

# Docker
.docker/
docker-compose.override.yml

# Redaktor / IS
.idea/
*.swp
.vscode/*
!.vscode/extensions.json

# `scripts/backup-ru-columns.ts` bura yazır — baza qeydləri (email, ad və s.
# ola bilər), heç vaxt commit edilməməlidir
/scripts/ru-columns-backup.json

# Prisma — yaradilan klient
/prisma/generated/

# Agent alətlerinin yerli qovluqlari
/.agents/
/.cursor/
/.devin/
/.claude/
nul
